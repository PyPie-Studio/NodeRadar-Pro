<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <Title>NodeRadar Pro</Title>
    <Authors>PyPie Studio</Authors>
    <PackageIcon>NodeRadar Pro Icon.png</PackageIcon>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon>Resources\NodeRadar Pro Icon.ico</ApplicationIcon>
    <Version>2.2.0</Version>
  </PropertyGroup>

  <PropertyGroup Label="Avalonia">
    <EnableAvaloniaXamlCompilation>True</EnableAvaloniaXamlCompilation>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Resources\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\NodeRadar Pro Icon.ico" />
    <EmbeddedResource Include="..\..\CHANGELOG.md" Link="Resources\CHANGELOG.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" />
    <PackageReference Include="LiteDB" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="System.Management" />
    <PackageReference Include="System.Windows.Extensions" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Roslynator.Analyzers">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Using Include="NodeRadarPro.Core.Engines" />
    <Using Include="NodeRadarPro.Core.Engines.Abstractions" />
    <Using Include="NodeRadarPro.Core.Models" />
    <Using Include="NodeRadarPro.Core.Services" />
    <Using Include="NodeRadarPro.UI.Pages" />
    <Using Include="NodeRadarPro.UI.Controls" />
    <Using Include="NodeRadarPro.UI.Navigation" />
    <Using Include="NodeRadarPro.UI.Theme" />
    <Using Include="NodeRadarPro.UI.Shell" />
  </ItemGroup>
</Project>
